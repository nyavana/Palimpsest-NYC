# ─────────────────────────────────────────────────────────────
# Palimpsest NYC — example environment variables (production)
#
# Copy to `.env` on the prod host and fill in the blanks.
# Then: chmod 600 .env  (the file holds the DB password and any
# OpenRouter API key; world-readable on a multi-user host is a leak).
#
# Generate a strong POSTGRES_PASSWORD with:
#   openssl rand -base64 36 | tr -d /=+ | cut -c -40
#
# This file is the production counterpart of .env.example. Differences
# vs. dev: APP_ENV=production (gates FastAPI /docs, /redoc, /openapi.json),
# CORS pinned to the public host, VITE_API_BASE_URL pinned to the public
# host, no devpassword default.
# ─────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── OpenRouter (cloud LLM) ──────────────────────────────────
# Leave OPENROUTER_API_KEY blank to enable BYOK mode (each user supplies
# their own key via the web UI). Set it to use a single shared key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STANDARD_MODEL=google/gemma-4-31b-it:free
OPENROUTER_COMPLEX_MODEL=google/gemma-4-31b-it:free

# ── Local / "fast" LLM tier ─────────────────────────────────
LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1
LOCAL_LLM_MODEL=google/gemma-4-31b-it:free
LOCAL_LLM_API_KEY=

# ── LLM router cache TTLs (seconds) ─────────────────────────
LLM_CACHE_TTL_SIMPLE_S=86400
LLM_CACHE_TTL_STANDARD_S=21600
LLM_CACHE_TTL_COMPLEX_S=3600

# ── LLM router circuit breaker ──────────────────────────────
LLM_CB_FAIL_THRESHOLD=3
LLM_CB_WINDOW_S=60
LLM_CB_COOLDOWN_S=30

# ── Embeddings ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ── Postgres (PostGIS + pgvector + pg_trgm) ─────────────────
# Use a ≥32-char random password. See header for the openssl recipe.
POSTGRES_USER=palimpsest
POSTGRES_PASSWORD=
POSTGRES_DB=palimpsest
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Pin to the public origin(s). Comma-separated. Do NOT use "*".
API_CORS_ORIGINS=https://palimpsest-demo.nyavana.io
API_WORKERS=2

# ── Agent ───────────────────────────────────────────────────
AGENT_MAX_TURNS=6

# ── Meta-instrumentation ────────────────────────────────────
META_SESSION_LOG_DIR=/app/logs/claude-sessions

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_MODE=dense
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=false

# ── Web frontend ────────────────────────────────────────────
# Baked into the static bundle at build time. Pin to the public origin.
VITE_API_BASE_URL=https://palimpsest-demo.nyavana.io
VITE_MAP_ENGINE=maplibre
VITE_GOOGLE_MAP_TILES_API_KEY=

# ── Prod image tag ──────────────────────────────────────────
# Consumed by docker-compose.prod.yml. Set per release.
PALIMPSEST_TAG=0.1.0
