[Unit]
Description=Refresh UFW allowlist for Cloudflare IP ranges (ports 80/443)
After=network-online.target ufw.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/refresh-cf-ufw

# Tightening: the script needs root for ufw, but nothing else.
# ufw writes to /etc/ufw/user{,6}.rules and locks under /run/ufw, so
# we can't use ProtectSystem=strict. ProtectSystem=full keeps /usr and
# /boot read-only while leaving /etc writable; we further pin the
# allowed write paths explicitly.
ProtectSystem=full
# Leading '-' makes the path optional: systemd silently skips entries
# that don't exist instead of failing the mount-namespace setup. On
# Ubuntu 24.04 /var/lib/ufw and /run/ufw are not created until ufw
# runs, but they may exist on other distros — list both so the unit
# is portable.
ReadWritePaths=/etc/ufw /var/log -/var/lib/ufw -/run/ufw -/run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
